# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file
# 　　　 You can set up a superuser's username and password
#        If there is no need for user management, set IDRFLOW_AUTO_LOGIN=true and delete IDRFLOW_SUPERUSER and IDRFLOW_SUPERUSER_PASSWORD.

IDRFLOW_AUTO_LOGIN=false
IDRFLOW_SUPERUSER=admin
IDRFLOW_SUPERUSER_PASSWORD=123456