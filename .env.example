# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file

# Config directory
# Directory where files, logs and database will be stored
# Example: IDRFLOW_CONFIG_DIR=~/.langflow
IDRFLOW_CONFIG_DIR=

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in Langflow's root directory
# This means that the database will be deleted when Langflow is uninstalled
# and that the database will not be shared between different virtual environments
# Example: IDRFLOW_SAVE_DB_IN_CONFIG_DIR=true
IDRFLOW_SAVE_DB_IN_CONFIG_DIR=

# Database URL
# Postgres example: IDRFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langflow
# SQLite example:
IDRFLOW_DATABASE_URL=sqlite:///./langflow.db

# Alembic logs path flag. If set to true, Alembic will log to stdout.
IDRFLOW_ALEMBIC_LOG_TO_STDOUT=False


# mem0 creates a directory
# for chat history, vector stores, and other artifacts
# its default path is ~/.mem0.
# we can change this path with
# environment variable "MEM0_DIR"
# Example: MEM0_DIR=/tmp/.mem0

# composio creates a cache directory
# for file uploads/downloads.
# its default path is ~/.composio
# we can change this path with
# environment variable "COMPOSIO_CACHE_DIR"
# Example: COMPOSIO_CACHE_DIR=/tmp/.composio


# Database connection retry
# Values: true, false
# If true, the database will retry to connect to the database if it fails
# Example: IDRFLOW_DATABASE_CONNECTION_RETRY=true
IDRFLOW_DATABASE_CONNECTION_RETRY=false

# Cache type
IDRFLOW_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: IDRFLOW_HOST=localhost
IDRFLOW_HOST=

# Worker processes
# Example: IDRFLOW_WORKERS=1
IDRFLOW_WORKERS=

# Server port
# Example: IDRFLOW_PORT=7860
IDRFLOW_PORT=

# Logging level
# Example: IDRFLOW_LOG_LEVEL=critical
IDRFLOW_LOG_LEVEL=

# Path to the log file
# Example: IDRFLOW_LOG_FILE=logs/langflow.log
IDRFLOW_LOG_FILE=

# Time/Size for log to rotate
# Example: IDRFLOW_LOG_ROTATION=‘10 MB’/‘1 day’
IDRFLOW_LOG_ROTATION=

# Path to the frontend directory containing build files
# Example: IDRFLOW_FRONTEND_PATH=/path/to/frontend/build/files
IDRFLOW_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: IDRFLOW_OPEN_BROWSER=true
IDRFLOW_OPEN_BROWSER=

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: IDRFLOW_REMOVE_API_KEYS=false
IDRFLOW_REMOVE_API_KEYS=

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: IDRFLOW_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# IDRFLOW_REDIS_HOST (default: localhost)
# IDRFLOW_REDIS_PORT (default: 6379)
# IDRFLOW_REDIS_DB (default: 0)
# IDRFLOW_REDIS_CACHE_EXPIRE (default: 3600)
IDRFLOW_CACHE_TYPE=

# Set IDRFLOW_AUTO_LOGIN to false if you want to disable auto login
# and use the login form to login. IDRFLOW_SUPERUSER and IDRFLOW_SUPERUSER_PASSWORD
# must be set if AUTO_LOGIN is set to false
# Values: true, false
IDRFLOW_AUTO_LOGIN=

# SET IDRFLOW_ENABLE_SUPERUSER_CLI to false to disable
# superuser creation via the CLI
IDRFLOW_ENABLE_SUPERUSER_CLI=

# Superuser username
# Example: IDRFLOW_SUPERUSER=admin
IDRFLOW_SUPERUSER=

# Superuser password
# Example: IDRFLOW_SUPERUSER_PASSWORD=123456
IDRFLOW_SUPERUSER_PASSWORD=

# API Key Source
# Controls how API keys are validated for the x-api-key header
# Values: db, env
# - db (default): Validates against API keys stored in the database
# - env: Validates against the IDRFLOW_API_KEY environment variable
# Example: IDRFLOW_API_KEY_SOURCE=db
IDRFLOW_API_KEY_SOURCE=

# API Key (only used when IDRFLOW_API_KEY_SOURCE=env)
# The API key to use for authentication when API_KEY_SOURCE is set to 'env'
# This allows injecting a pre-defined API key via environment variables
# (useful for Kubernetes Secrets, CI/CD pipelines, etc.)
# Example: IDRFLOW_API_KEY=your-secure-api-key
IDRFLOW_API_KEY=

# Should store environment variables in the database
# Values: true, false
IDRFLOW_STORE_ENVIRONMENT_VARIABLES=

# SSRF (Server-Side Request Forgery) Protection
# When enabled, blocks requests to private IP ranges, localhost, and cloud metadata endpoints
# Values: true, false
# Default: false (for backward compatibility)
# Set to true to enable protection against SSRF attacks
IDRFLOW_SSRF_PROTECTION_ENABLED=

# SSRF Allowed Hosts
# Comma-separated list of hosts/IPs/CIDR ranges to allow despite SSRF protection
# Supports: exact hostnames, wildcard domains (*.example.com), exact IPs, CIDR ranges
# Example: IDRFLOW_SSRF_ALLOWED_HOSTS=internal-api.company.local,192.168.1.0/24,*.dev.internal
# Note: Only takes effect when IDRFLOW_SSRF_PROTECTION_ENABLED=true
IDRFLOW_SSRF_ALLOWED_HOSTS=

# Should enable the MCP composer feature in MCP projects
# Values: true, false
# Default: true
IDRFLOW_MCP_COMPOSER_ENABLED=

# STORE_URL
# Example: IDRFLOW_STORE_URL=https://api.langflow.store
# IDRFLOW_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# IDRFLOW_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# IDRFLOW_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=
